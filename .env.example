# === API Keys ===
# Thứ tự fallback dịch: Opus → Gemini → Groq (stream) → Google Translate
OPUS_API_KEY=your_opus_api_key_here
OPUS_API_URL=https://api.justwoker.icu/v1/messages
OPUS_MODEL=claude-opus-4-8
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSLATE_MODEL=llama-3.3-70b-versatile

# === TTS Settings ===
# TTS_ENGINE=vieneu (VieNeu-TTS on-device neural, mặc định) | edge (Edge-TTS cloud, fallback)
TTS_ENGINE=vieneu
TTS_VOICE=vi-VN-HoaiMyNeural
# Options: vi-VN-HoaiMyNeural (female), vi-VN-NamMinhNeural (male)
VIENEU_VOICE=Hải Đăng
# Giọng Edge-TTS dùng khi VieNeu lỗi (fallback)
EDGE_FALLBACK_VOICE=vi-VN-HoaiMyNeural

# === YouTube Upload ===
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_CREDENTIALS_FILE=youtube_credentials.json

# === Facebook Upload ===
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_ACCESS_TOKEN=your_long_lived_page_token

# === Processing Settings ===
VIDEO_QUALITY=720  # 480, 720, 1080
ORIGINAL_AUDIO_VOLUME=0.12  # 12% giữ âm nền gốc
OUTPUT_DIR=./output
